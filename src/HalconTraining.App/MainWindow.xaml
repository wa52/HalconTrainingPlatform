<Window x:Class="HalconTraining.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:HalconTraining.App.Views" Title="HALCON 训练平台" Width="1380" Height="920" MinWidth="1120" MinHeight="780" WindowStartupLocation="CenterScreen" Background="{StaticResource AppSurfaceBrush}" Foreground="{StaticResource InkBrush}" FontFamily="Microsoft YaHei UI" FontSize="14">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="VisibleWhen"/>
  <Style x:Key="VisibleIdle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CanStop}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="ChooseDataset" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding HasDataset}" Value="True"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/></DataTrigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid Background="{StaticResource AppSurfaceBrush}">
  <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,10">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="HALCON 训练平台" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0"><TextBlock Text="{Binding CurrentTaskName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentDatasetPath}"/><TextBlock Text="{Binding CurrentDatasetCaption}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="{Binding EnvironmentState}" VerticalAlignment="Center" ToolTip="{Binding EnvironmentDetails}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding EnvironmentHealthy}" Value="True"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding EnvironmentAttention}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <Button Content="检查环境" Command="{Binding ProbeEnvironmentCommand}" IsEnabled="{Binding IsIdle}" Padding="10,6" Margin="12,0,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <TabControl x:Name="Pages" Grid.Row="1" SelectedIndex="{Binding SelectedPageIndex}" Background="Transparent" BorderThickness="0" Padding="0" TabStripPlacement="Top">
   <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Padding" Value="32,14"/><Setter Property="FontSize" Value="15"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="White" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}"><ContentPresenter x:Name="TabLabel" ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="TabLabel" Property="TextElement.Foreground" Value="{StaticResource AccentBrush}"/><Setter TargetName="TabLabel" Property="TextElement.FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="Background" Value="{StaticResource AppSurfaceBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></TabControl.Resources>
   <TabItem Header="数据集">
    <TabControl x:Name="DatasetPages" Background="Transparent" BorderThickness="0" Padding="0">
     <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Padding" Value="20,10"/><Setter Property="FontSize" Value="13"/></Style></TabControl.Resources>
     <TabItem Header="浏览数据集">
    <Grid Margin="24,16,24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,16"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="BrowseDatasetButton" Content="选择数据集" Style="{StaticResource ChooseDataset}" Command="{Binding BrowseDatasetCommand}" IsEnabled="{Binding IsIdle}"/><Button x:Name="GoTrainingButton" Content="下一步：训练" Command="{Binding GoTrainingCommand}" IsEnabled="{Binding CanTrain}" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Visibility="{Binding HasDataset,Converter={StaticResource VisibleWhen}}"/></StackPanel><StackPanel><TextBlock Text="数据集" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding TrainingReadiness}" Style="{StaticResource Subtitle}" Margin="0,6,16,0"/></StackPanel></DockPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="图片列表" FontWeight="SemiBold" Margin="0,0,0,10"/>
       <DataGrid Grid.Row="1" ItemsSource="{Binding Samples}" SelectedItem="{Binding SelectedSample}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="图像" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="集合" Binding="{Binding Split}" Width="72"/><DataGridCheckBoxColumn Header="缺失" Binding="{Binding Missing}" Width="48"/></DataGrid.Columns></DataGrid>
       <StackPanel Grid.Row="2" Margin="0,12,0,0"><Expander Header="类别"><ItemsControl ItemsSource="{Binding Classes}" Margin="16,8"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander><Expander Header="{Binding DataCheckSummary}"><StackPanel Margin="0,8"><TextBlock Text="{Binding Issues}" TextWrapping="Wrap" MaxHeight="160" Foreground="{StaticResource WarningBrush}"/><TextBlock Text="{Binding DatasetSummary}" Style="{StaticResource Subtitle}"/><TextBlock Text="{Binding DatasetPath}" TextWrapping="Wrap" FontSize="12"/></StackPanel></Expander></StackPanel>
      </Grid>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DockPanel Margin="0,0,0,10"><CheckBox DockPanel.Dock="Right" Content="显示标注" IsChecked="{Binding ShowAnnotations}" Visibility="{Binding HasMasks,Converter={StaticResource VisibleWhen}}"/><TextBlock Text="{Binding SampleCaption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SampleCaption}" Foreground="{StaticResource MutedBrush}"/></DockPanel>
       <views:HalconImageView x:Name="DatasetImage" Grid.Row="1" ImagePath="{Binding PreviewPath}" MaskPath="{Binding PreviewMaskPath}"/>
       <DockPanel Grid.Row="2" Margin="0,12,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="上一张" Command="{Binding PreviousSampleCommand}" IsEnabled="{Binding CanPreviousSample}"/><Button Content="下一张" Command="{Binding NextSampleCommand}" IsEnabled="{Binding CanNextSample}" Margin="8,0,0,0"/></StackPanel><TextBlock Text="{Binding SampleLabel}" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
      </Grid>
     </Grid>
    </Grid>
     </TabItem>
     <TabItem Header="目标检测 · 主动学习">
      <views:DetectionActiveLearningView DataContext="{Binding ActiveLearning}"/>
     </TabItem>
    </TabControl>
   </TabItem>
   <TabItem Header="训练">
    <Grid Margin="24,16,24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,16"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
      <Button x:Name="StartTrainingButton" Content="{Binding StartTrainingLabel}" Command="{Binding StartTrainingCommand}" IsEnabled="{Binding CanTrain}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding IsTraining}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding HasCompletedTraining}" Value="True"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
      <Button x:Name="StopTrainingButton" Content="停止训练" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" Style="{StaticResource PrimaryButton}" Visibility="{Binding IsTraining,Converter={StaticResource VisibleWhen}}"/>
      <Button x:Name="ViewModelButton" Content="查看模型并测试" Command="{Binding GoModelsCommand}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsIdle}" Margin="12,0,0,0" Visibility="{Binding HasCompletedTraining,Converter={StaticResource VisibleWhen}}"/>
     </StackPanel><StackPanel><TextBlock Text="模型训练" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding DatasetCaption}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/><TextBlock Text="{Binding TrainingReadiness}" Style="{StaticResource Subtitle}" Margin="0,6,16,0"/></StackPanel></DockPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding ParametersWidth}"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="White" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
       <TextBlock Text="训练参数" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
       <StackPanel x:Name="CoreParameters" IsEnabled="{Binding IsIdle}"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsTraining}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <TextBlock Text="图像尺寸 · 宽 × 高"/><UniformGrid Columns="2"><TextBox x:Name="ImageWidthInput" Height="34" MinHeight="32" Padding="8,5" Text="{Binding ImageWidth,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" Margin="0,5,8,0"/><TextBox x:Name="ImageHeightInput" Height="34" MinHeight="32" Padding="8,5" Text="{Binding ImageHeight,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" Margin="0,5,0,0"/></UniformGrid>
        <TextBlock Text="Batch Size" Margin="0,6,0,0"/><TextBox x:Name="BatchInput" Height="34" MinHeight="32" Padding="8,5" Text="{Binding Batch,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" Margin="0,5,0,0"/>
        <TextBlock Text="训练轮数 Epoch" Margin="0,6,0,0"/><TextBox x:Name="EpochInput" Height="34" MinHeight="32" Padding="8,5" Text="{Binding Epochs,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" Margin="0,5,0,0"/>
        <TextBlock Text="学习率 Learning Rate" Margin="0,6,0,0"/><TextBox x:Name="LearningRateInput" Height="34" MinHeight="32" Padding="8,5" Text="{Binding LearningRate,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" Margin="0,5,0,0"/>
       </StackPanel>
       <TextBlock Text="{Binding ParameterSummary}" Foreground="{StaticResource MutedBrush}" LineHeight="26" Visibility="{Binding IsTraining,Converter={StaticResource VisibleWhen}}"/>
       <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,10,0,0"><StackPanel>
        <DockPanel><Button DockPanel.Dock="Right" Content="更新划分" Command="{Binding RepartitionCommand}" IsEnabled="{Binding CanRefreshSplit}" Padding="8,3" MinHeight="26" Visibility="{Binding HasPendingSplit,Converter={StaticResource VisibleWhen}}"/><TextBlock x:Name="SplitRatioText" DockPanel.Dock="Right" Text="{Binding SplitRatioSummary}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="数据集划分" FontWeight="SemiBold"/></DockPanel>
        <UniformGrid Columns="3" Margin="0,8,0,0"><StackPanel><TextBlock Text="训练集" FontSize="12" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding TrainCountText}" FontFamily="Consolas" FontSize="16"/></StackPanel><StackPanel><TextBlock Text="验证集" FontSize="12" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding ValidationCountText}" FontFamily="Consolas" FontSize="16"/></StackPanel><StackPanel><TextBlock Text="测试集" FontSize="12" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding TestCountText}" FontFamily="Consolas" FontSize="16"/></StackPanel></UniformGrid>
        <TextBlock Text="基础模型 · 自动匹配" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,3"/><TextBlock x:Name="BaseModelSummary" Text="{Binding BaseModelName}" TextWrapping="Wrap" FontSize="12" ToolTip="{Binding ModelPath}"/>
       </StackPanel></Border>
       <Expander x:Name="AdvancedParameters" Header="高级参数" IsExpanded="{Binding AreAdvancedParametersExpanded}" IsEnabled="{Binding IsIdle}" Margin="0,6,0,0"><StackPanel Margin="0,8,0,0">
        <TextBlock Text="随机种子"/><TextBox Text="{Binding Seed,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/>
        <TextBlock Text="训练集 / 验证集（%）" Margin="0,10,0,0"/><UniformGrid Columns="2"><TextBox Text="{Binding TrainPercent,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" Margin="0,6,8,0"/><TextBox Text="{Binding ValidationPercent,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/></UniformGrid>
        <TextBlock Text="测试集使用剩余比例；修改比例或种子后更新划分。" Style="{StaticResource Subtitle}"/><Button Content="更新划分" Command="{Binding RepartitionCommand}" IsEnabled="{Binding CanRefreshSplit}" HorizontalAlignment="Left"/>
        <TextBlock Text="验证间隔（轮）" Margin="0,10,0,0"/><TextBox Text="{Binding ValidationInterval,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/>
        <TextBlock Text="{Binding TaskParameterHeader}" FontWeight="SemiBold" Margin="0,14,0,6"/><TextBlock Text="{Binding TaskParameterSummary}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
        <Button Content="保存参数" Command="{Binding SaveParametersCommand}" Margin="0,12,0,0" HorizontalAlignment="Left"/>
       </StackPanel></Expander>
      </StackPanel></ScrollViewer></Border>
      <views:TrainingMonitorView Grid.Column="2"/>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="模型">
    <Grid Margin="24,16,24,20"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshModelsCommand}" IsEnabled="{Binding IsIdle}"/><TextBlock Text="模型" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/></DockPanel>
      <ListBox Grid.Row="1" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" IsEnabled="{Binding IsIdle}" BorderBrush="{StaticResource LineBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,12"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Task,Converter={StaticResource ModelLabel}}" FontSize="12" Margin="0,4"/><TextBlock Text="{Binding Status,Converter={StaticResource ModelLabel}}" FontSize="12" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Directory,Converter={StaticResource ModelLabel},ConverterParameter=run}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      <Expander Grid.Row="2" Header="测试历史" Margin="0,12,0,0"><ListBox ItemsSource="{Binding TestResults}" SelectedItem="{Binding SelectedResult}" DisplayMemberPath="File" Height="150"/></Expander>
     </Grid>
     <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="选择原图测试" Command="{Binding TestImagesCommand}" IsEnabled="{Binding CanTest}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding IsTesting}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="停止测试" Command="{Binding StopCommand}" Style="{StaticResource PrimaryButton}" Visibility="{Binding IsTesting,Converter={StaticResource VisibleWhen}}"/></StackPanel><TextBlock Text="{Binding ModelTestReadiness}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/></DockPanel>
      <TextBlock Grid.Row="1" Text="{Binding ModelEvaluationSummary}" FontWeight="SemiBold" Margin="0,0,0,14"/>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding OriginalImageWidth}"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="原图" Foreground="{StaticResource MutedBrush}"/><views:HalconImageView Grid.Row="1" ImagePath="{Binding TestOriginalPath}"/></Grid>
       <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding TestResultTitle}" Foreground="{StaticResource MutedBrush}"/>
        <views:HalconImageView Grid.Row="1" ImagePath="{Binding TestOriginalPath}" MaskPath="{Binding TestMaskPath}" OpacityPercent="{Binding OverlayOpacity}"><views:HalconImageView.Style><Style TargetType="views:HalconImageView"><Style.Triggers><DataTrigger Binding="{Binding IsClassificationModel}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></views:HalconImageView.Style></views:HalconImageView>
        <Border Grid.Row="1" Background="White" Padding="20"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsClassificationModel}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding TestCaption,TargetNullValue=选择原图后显示预测类别}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/><Expander Header="全部类别置信度" Margin="0,20,0,0"><ItemsControl ItemsSource="{Binding ClassificationScores}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,6"><TextBlock Text="{Binding Confidence,StringFormat=P2}" Width="80" DockPanel.Dock="Right" TextAlignment="Right" FontFamily="Consolas"/><TextBlock Text="{Binding ClassName}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander></StackPanel></ScrollViewer></Border>
       </Grid>
      </Grid>
      <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap"/><Expander Header="详细信息与显示设置"><StackPanel Margin="0,12,0,0"><TextBlock Text="{Binding ModelSummary}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="模型文件夹" Command="{Binding OpenModelFolderCommand}"/><Button Content="结果文件夹" Command="{Binding OpenResultsFolderCommand}" Margin="8,0,0,0"/><Button Content="保存叠加图" Command="{Binding SaveOverlayCommand}" IsEnabled="{Binding CanSaveOverlay}" Margin="8,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="叠加透明度" VerticalAlignment="Center"/><Slider Value="{Binding OverlayOpacity}" Minimum="0" Maximum="100" Width="180" Margin="12,0"/></StackPanel><TextBlock Text="运行日志" FontWeight="SemiBold" Margin="0,16,0,8"/><TextBox Text="{Binding LogText,Mode=OneWay}" IsReadOnly="True" Height="100" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontSize="12"/></StackPanel></Expander></StackPanel>
     </Grid>
    </Grid>
   </TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,10"><TextBlock Text="{Binding CurrentStatus}" TextWrapping="Wrap" MaxHeight="60"/></Border>
 </Grid>
</Window>
