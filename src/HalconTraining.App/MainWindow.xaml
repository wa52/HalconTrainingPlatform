<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="HalconTraining.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:HalconTraining.App.Views" Title="HALCON 训练平台" Width="1380" Height="920" MinWidth="1120" MinHeight="780" WindowStartupLocation="CenterScreen" Background="{StaticResource AppSurfaceBrush}" Foreground="{StaticResource InkBrush}" FontFamily="Microsoft YaHei UI" FontSize="13">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="72" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,12">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="检查环境" Command="{Binding ProbeEnvironmentCommand}" IsEnabled="{Binding IsIdle}" />
        <TextBlock DockPanel.Dock="Right" Text="HALCON 24.11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,20,0" />
        <StackPanel>
          <TextBlock Text="HALCON 训练平台" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="数据集 · 训练 · 模型测试" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>
    <TabControl Grid.Row="1" TabStripPlacement="Left" SelectedIndex="{Binding SelectedPageIndex}" Background="Transparent" BorderThickness="0">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="FontSize" Value="15" />
          <Setter Property="Padding" Value="22,16" />
          <Setter Property="MinWidth" Value="165" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="TabItem">
                <Border x:Name="Nav" Padding="{TemplateBinding Padding}" Margin="8,5" Background="Transparent" CornerRadius="4">
                  <ContentPresenter ContentSource="Header" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Nav" Property="Background" Value="#E4EFF9" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </TabControl.Resources>
      <TabItem Header="项目总览">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24">
            <TextBlock Text="项目总览" Style="{StaticResource PageTitle}" />
            <TextBlock Text="浏览数据集，调整参数，完成模型训练与原图测试。" Style="{StaticResource Subtitle}" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="当前数据集" Style="{StaticResource CardTitle}" />
                <TextBlock Text="{Binding TaskName}" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,4" />
                <TextBlock Text="{Binding DatasetSummary}" Foreground="{StaticResource MutedBrush}" />
                <Button Content="浏览数据集" Command="{Binding BrowseDatasetCommand}" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Left" Margin="0,18,0,0" Style="{StaticResource PrimaryButton}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="运行环境" Style="{StaticResource CardTitle}" />
                <TextBlock Text="{Binding EnvironmentText}" Margin="0,12,0,0" TextWrapping="Wrap" />
                <TextBlock Text="支持图像分类、语义分割的真实训练与原图测试。选择数据集后自动匹配任务和基础模型。" Style="{StaticResource Subtitle}" />
                <TextBlock Text="{Binding Root}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="数据集">
        <Grid Margin="24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="浏览数据集" Style="{StaticResource PrimaryButton}" Command="{Binding BrowseDatasetCommand}" IsEnabled="{Binding IsIdle}" />
            <StackPanel>
              <TextBlock Text="数据集" Style="{StaticResource PageTitle}" />
              <TextBlock Text="直接选择 .hdict / .json，自动识别任务和划分。" Style="{StaticResource Subtitle}" />
            </StackPanel>
          </DockPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="{Binding TaskName}" FontSize="19" FontWeight="SemiBold" />
              <TextBlock Text="{Binding TaskLabel}" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0" />
              <TextBlock Text="{Binding DatasetSummary}" Margin="0,8,0,0" />
              <TextBlock Text="{Binding DatasetPath}" TextWrapping="Wrap" Style="{StaticResource Subtitle}" />
            </StackPanel>
          </Border>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.1*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Samples}" SelectedItem="{Binding SelectedSample}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,18,0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="图像" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="划分" Binding="{Binding Split}" Width="80" />
                <DataGridCheckBoxColumn Header="缺失" Binding="{Binding Missing}" Width="55" />
              </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Column="1">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <views:HalconImageView ImagePath="{Binding PreviewPath}" />
              <TextBlock Grid.Row="1" Text="{Binding Issues}" TextWrapping="Wrap" Foreground="#A35B16" Margin="0,14,0,0" MaxHeight="130" />
            </Grid>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="训练">
        <Grid Margin="24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="开始训练" Command="{Binding StartTrainingCommand}" IsEnabled="{Binding CanTrain}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
              <Button Content="停止" Command="{Binding StopCommand}" IsEnabled="{Binding IsBusy}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="训练" Style="{StaticResource PageTitle}" />
              <TextBlock Text="{Binding TaskName}" Style="{StaticResource Subtitle}" />
            </StackPanel>
          </DockPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,18,0">
              <StackPanel IsEnabled="{Binding IsIdle}">
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="数据与模型" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding DatasetSummary}" Margin="0,12,0,6" TextWrapping="Wrap" />
                    <Button Content="浏览数据集" Command="{Binding BrowseDatasetCommand}" HorizontalAlignment="Left" />
                    <Expander Header="自动识别与基础模型" Margin="0,18,0,0">
                      <StackPanel>
                        <TextBlock Text="{Binding TaskLabel}" Margin="0,10,0,6" />
                        <TextBlock Text="{Binding ModelPath}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="常用参数" Style="{StaticResource CardTitle}" />
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                      <StackPanel Margin="0,0,12,14">
                        <TextBlock Text="图像宽度" />
                        <TextBox Text="{Binding ImageWidth,ValidatesOnExceptions=True}" />
                      </StackPanel>
                      <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="图像高度" />
                        <TextBox Text="{Binding ImageHeight,ValidatesOnExceptions=True}" />
                      </StackPanel>
                      <StackPanel Margin="0,0,12,14">
                        <TextBlock Text="Batch size" />
                        <TextBox Text="{Binding Batch,ValidatesOnExceptions=True}" />
                      </StackPanel>
                      <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="训练轮数 Epochs" />
                        <TextBox Text="{Binding Epochs,ValidatesOnExceptions=True}" />
                      </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="学习率" />
                    <TextBox Text="{Binding LearningRate,ValidatesOnExceptions=True}" />
                    <Expander Header="高级参数与数据划分" Margin="0,18,0,0">
                      <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="随机种子" />
                        <TextBox Text="{Binding Seed,ValidatesOnExceptions=True}" />
                        <UniformGrid Columns="2" Margin="0,10,0,0">
                          <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="训练集 %" />
                            <TextBox Text="{Binding TrainPercent,ValidatesOnExceptions=True}" />
                          </StackPanel>
                          <StackPanel>
                            <TextBlock Text="验证集 %" />
                            <TextBox Text="{Binding ValidationPercent,ValidatesOnExceptions=True}" />
                          </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="测试集使用剩余比例；有工件/批次ID时按组划分。" Style="{StaticResource Subtitle}" />
                        <Button Content="重新划分" Command="{Binding RepartitionCommand}" HorizontalAlignment="Left" />
                        <TextBlock Text="验证间隔（轮）" Margin="0,14,0,0" />
                        <TextBox Text="{Binding ValidationInterval,ValidatesOnExceptions=True}" />
                      </StackPanel>
                    </Expander>
                    <Button Content="保存参数" Command="{Binding SaveParametersCommand}" Margin="0,18,0,0" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
            <views:TrainingMonitorView Grid.Column="1" />
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="模型管理">
        <Grid Margin="24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="90" />
          </Grid.RowDefinitions>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="刷新模型库" Command="{Binding RefreshModelsCommand}" IsEnabled="{Binding IsIdle}" />
            <StackPanel>
              <TextBlock Text="模型管理" Style="{StaticResource PageTitle}" />
              <TextBlock Text="固定分类目录保存模型；选择模型后直接测试原图。" Style="{StaticResource Subtitle}" />
            </StackPanel>
          </DockPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Models}" IsEnabled="{Binding IsIdle}" SelectedItem="{Binding SelectedModel}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="任务名 / 数据集" Binding="{Binding Name}" Width="160" />
              <DataGridTextColumn Header="任务类别" Binding="{Binding Task,Converter={StaticResource ModelLabel}}" Width="180" />
              <DataGridTextColumn Header="状态" Binding="{Binding Status,Converter={StaticResource ModelLabel}}" Width="180" />
              <DataGridTextColumn Header="训练版本" Binding="{Binding Directory,Converter={StaticResource ModelLabel},ConverterParameter=run}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="2" Text="{Binding ModelSummary}" Style="{StaticResource Subtitle}" TextWrapping="Wrap" Margin="0,10,0,12" />
          <DockPanel Grid.Row="3" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
              <Button Content="选择原图 · 可多选" Command="{Binding TestImagesCommand}" IsEnabled="{Binding CanTest}" Style="{StaticResource PrimaryButton}" />
              <Button Content="停止" Command="{Binding StopCommand}" IsEnabled="{Binding IsBusy}" Margin="8,0,0,0" />
              <Button Content="保存叠加图" Command="{Binding SaveOverlayCommand}" IsEnabled="{Binding CanSaveOverlay}" Margin="8,0,0,0" />
              <Button Content="模型文件夹" Command="{Binding OpenModelFolderCommand}" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsClassificationModel}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
              <TextBlock Text="透明度" VerticalAlignment="Center" />
              <Slider Value="{Binding OverlayOpacity}" Minimum="0" Maximum="100" Width="110" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
          </DockPanel>
          <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,8,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Text="原图" Foreground="{StaticResource MutedBrush}" />
              <views:HalconImageView Grid.Row="1" ImagePath="{Binding TestOriginalPath}" />
            </Grid>
            <Grid Grid.Column="1" Margin="8,0,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Text="{Binding TestResultTitle}" Foreground="{StaticResource MutedBrush}" />
              <views:HalconImageView Grid.Row="1" ImagePath="{Binding TestOriginalPath}" Caption="{Binding TestCaption}" MaskPath="{Binding TestMaskPath}" OpacityPercent="{Binding OverlayOpacity}"><views:HalconImageView.Style><Style TargetType="views:HalconImageView"><Style.Triggers><DataTrigger Binding="{Binding IsClassificationModel}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></views:HalconImageView.Style></views:HalconImageView>
              <Border Grid.Row="1" Background="White" Padding="18"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsClassificationModel}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding TestCaption,TargetNullValue=选择原图后显示分类结果}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/><ItemsControl ItemsSource="{Binding ClassificationScores}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,4"><TextBlock Text="{Binding Confidence,StringFormat=P2}" DockPanel.Dock="Right" Width="80" TextAlignment="Right" FontFamily="Consolas"/><TextBlock Text="{Binding ClassName}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Border>
            </Grid>
          </Grid>
          <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />

              <Button Content="打开结果文件夹" Command="{Binding OpenResultsFolderCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
            </StackPanel>
            <ListBox Grid.Column="1" ItemsSource="{Binding TestResults}" SelectedItem="{Binding SelectedResult}" DisplayMemberPath="File" />
          </Grid>
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,9">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxHeight="100" />
    </Border>
  </Grid>
</Window>