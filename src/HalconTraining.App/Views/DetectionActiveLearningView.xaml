<UserControl x:Class="HalconTraining.App.Views.DetectionActiveLearningView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:HalconTraining.App.Views">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button Content="选择图片先标注" Command="{Binding SeedCommand}" IsEnabled="{Binding IsIdle}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
    <Button Content="已有模型批量预测" Command="{Binding PredictExistingCommand}" IsEnabled="{Binding IsIdle}" Margin="0,0,8,0"/>
    <Button Content="导入预测JSON" Command="{Binding ImportCommand}" IsEnabled="{Binding IsIdle}" Margin="0,0,8,0"/>
    <Button Content="导出已确认 COCO" Command="{Binding ExportCommand}" IsEnabled="{Binding CanExport}"/>
   </StackPanel>
   <StackPanel>
    <TextBlock Text="目标检测 · 主动学习" Style="{StaticResource PageTitle}" FontSize="22"/>
    <TextBlock Text="人工确认满5张即可微调预训练模型 → 批量预测 → 人工审核" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12">
   <StackPanel>
    <DockPanel>
     <TextBlock Text="{Binding ModelInfo}" FontWeight="SemiBold"/>
     <TextBlock DockPanel.Dock="Right" Text="{Binding ReviewProgress}" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/>
    </DockPanel>
    <TextBlock Text="{Binding ClassesInfo}" FontSize="12" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,12">
    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="开始微调训练" Command="{Binding BootstrapCommand}" IsEnabled="{Binding CanBootstrap}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
        <Button Content="使用本轮模型预测" Command="{Binding PredictTrainedCommand}" IsEnabled="{Binding CanPredictTrained}" Margin="0,0,8,0"/>
        <Button Content="停止" Command="{Binding StopOperationCommand}" IsEnabled="{Binding CanStopOperation}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="微调训练" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <ComboBox SelectedValuePath="Content" SelectedValue="{Binding TrainingEngine,Mode=TwoWay}" Width="137" Margin="0,0,12,0" VerticalAlignment="Center">
          <ComboBoxItem Content="YOLO · 预训练"/>
          <ComboBoxItem Content="HALCON · 检测"/>
        </ComboBox>
        <TextBlock Text="Epoch" VerticalAlignment="Center"/>
        <TextBox Text="{Binding BootstrapEpochs,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True}" Width="47" Margin="5,0,12,0"/>
        <TextBlock Text="Batch" VerticalAlignment="Center"/>
        <TextBox Text="{Binding BootstrapBatch,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True}" Width="40" Margin="5,0,12,0"/>
        <TextBlock Text="尺寸" VerticalAlignment="Center"/>
        <TextBox Text="{Binding BootstrapSize,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True}" Width="55" Margin="5,0,12,0"/>
        <TextBlock Text="学习率" VerticalAlignment="Center"/>
        <TextBox Text="{Binding BootstrapRate,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True}" Width="75" Margin="5,0,0,0"/>
      </StackPanel>
    </DockPanel>
  </Border>
  <Grid Grid.Row="3">
   <Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="White" CornerRadius="5" Margin="0,0,12,0">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Padding="12,10" Text="审核队列 · 高优先级在前" FontWeight="SemiBold"/>
     <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedRow}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="38" BorderThickness="0">
      <DataGrid.Columns>
       <DataGridTextColumn Header="图片" Binding="{Binding Name}" Width="*"/>
       <DataGridTextColumn Header="优先" Binding="{Binding Priority}" Width="50"/>
       <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="65"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="195"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <views:DetectionImageView ImagePath="{Binding PreviewPath}" Boxes="{Binding PreviewBoxes}" DrawBoxCommand="{Binding DrawBoxCommand}"/>
    <TextBlock Grid.Row="1" Text="{Binding SelectedDetails}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,8" TextWrapping="Wrap"/>
    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="8">
     <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
       <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button Content="添加框" Command="{Binding AddBoxCommand}" IsEnabled="{Binding CanReview}" Margin="0,0,6,0"/>
        <Button Content="删除所选框" Command="{Binding RemoveBoxCommand}" IsEnabled="{Binding CanRemoveBox}"/>
       </StackPanel>
       <TextBlock Text="检测框 · 可直接在图片上拖拽画框，或输入像素坐标" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
      <DataGrid ItemsSource="{Binding Boxes}" SelectedItem="{Binding SelectedBox}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="32" Height="140">
       <DataGrid.Columns>
        <DataGridTextColumn Header="类别ID" Binding="{Binding ClassId,Mode=TwoWay,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True}" Width="75"/>
        <DataGridTextColumn Header="得分" Binding="{Binding Confidence,StringFormat=P0}" Width="64" IsReadOnly="True"/>
        <DataGridTextColumn Header="X1" Binding="{Binding Col1,Mode=TwoWay,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True,StringFormat=F1}" Width="*"/>
        <DataGridTextColumn Header="Y1" Binding="{Binding Row1,Mode=TwoWay,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True,StringFormat=F1}" Width="*"/>
        <DataGridTextColumn Header="X2" Binding="{Binding Col2,Mode=TwoWay,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True,StringFormat=F1}" Width="*"/>
        <DataGridTextColumn Header="Y2" Binding="{Binding Row2,Mode=TwoWay,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True,StringFormat=F1}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
    </Border>
    <DockPanel Grid.Row="3" Margin="0,10,0,0">
     <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
      <Button Content="保存草稿" Command="{Binding SaveDraftCommand}" IsEnabled="{Binding CanReview}" Margin="0,0,6,0"/>
      <Button Content="需重标" Command="{Binding ReworkCommand}" IsEnabled="{Binding CanReview}" Margin="0,0,6,0"/>
      <Button Content="接受并下一张" Command="{Binding ApproveCommand}" IsEnabled="{Binding CanReview}" Style="{StaticResource PrimaryButton}"/>
     </StackPanel>
     <Button Content="跳过 / 下一张" Command="{Binding NextCommand}" IsEnabled="{Binding CanReview}" HorizontalAlignment="Left"/>
    </DockPanel>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="4" Margin="0,12,0,0">
   <Button DockPanel.Dock="Right" Content="打开导出目录" Command="{Binding OpenExportCommand}" IsEnabled="{Binding CanOpenExport}"/>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="12"/>
  </DockPanel>
 </Grid>
</UserControl>
