<UserControl x:Class="HalconTraining.App.Views.DetectionActiveLearningView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:HalconTraining.App.Views">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleWhen"/><views:DetectionThumbnailConverter x:Key="Thumbnail"/></UserControl.Resources>
 <Grid Margin="20,6">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,6">
   <Button DockPanel.Dock="Right" x:Name="ImportFolderButton" Content="导入文件夹" Command="{Binding ImportFolderCommand}" IsEnabled="{Binding IsIdle}" Style="{StaticResource PrimaryButton}"/>
   <Button DockPanel.Dock="Right" x:Name="ExportHalconDatasetButton" Content="导出 .hdict" Command="{Binding ExportAllHalconCommand}" IsEnabled="{Binding CanExportAllHalcon}" Margin="0,0,8,0" ToolTip="合并各类别已确认的图像与标注，导出一份HALCON数据集；未确认图像不参与"/>
   <TextBlock Text="目标检测 · 标注与训练" Style="{StaticResource PageTitle}" FontSize="22" ToolTip="{Binding SourceDirectory}" VerticalAlignment="Center"/>
  </DockPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,6">
   <TextBlock DockPanel.Dock="Right" Text="{Binding ReviewProgress}" Foreground="{StaticResource MutedBrush}" Margin="16,0,0,0"/>
   <TextBlock Text="{Binding CombinedDatasetSummary}" ToolTip="{Binding TrainingEligibility}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
  </DockPanel>
  <Border Grid.Row="2" Background="White" Padding="10" Margin="0,0,0,8">
   <StackPanel><DockPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
      <Button x:Name="TrainDetectionButton" Content="{Binding TrainButtonLabel}" Command="{Binding BootstrapCommand}" IsEnabled="{Binding CanBootstrap}" ToolTip="仅用于当前类别的预标注模型；标注完成后使用合并HALCON训练"/>
      <Button x:Name="PredictRemainingButton" Content="{Binding PredictRemainingLabel}" Command="{Binding PredictRemainingCommand}" IsEnabled="{Binding CanPredictRemaining}" Margin="8,0,0,0" ToolTip="只预测当前类别文件夹内未确认、无人工草稿的图像"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding HasTrainedModel}" Value="False"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
      <Button x:Name="CombinedTrainingButton" Content="合并 HALCON 训练" Command="{Binding CombinedTrainCommand}" IsEnabled="{Binding CanCombinedTrain}" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" ToolTip="仅合并各类别已确认图像，使用上方显示的参数训练一个多类别模型"/>
<Button Content="停止" Command="{Binding StopOperationCommand}" IsEnabled="{Binding CanStopOperation}" Margin="8,0,0,0" Padding="10,7"/>
     </StackPanel>
    <WrapPanel x:Name="TrainingParameters" IsEnabled="{Binding IsIdle}">
     <TextBlock Text="图像尺寸" VerticalAlignment="Center"/><TextBox x:Name="DetectionSizeInput" Text="{Binding BootstrapSize,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" Width="65" Margin="6,0,16,0" MinHeight="32" Padding="7,5"/>
     <TextBlock Text="Batch" VerticalAlignment="Center"/><TextBox x:Name="DetectionBatchInput" Text="{Binding BootstrapBatch,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" Width="52" Margin="6,0,16,0" MinHeight="32" Padding="7,5"/>
     <TextBlock Text="Epoch" VerticalAlignment="Center"/><TextBox x:Name="DetectionEpochInput" Text="{Binding BootstrapEpochs,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" Width="58" Margin="6,0,16,0" MinHeight="32" Padding="7,5"/>
     <TextBlock Text="学习率" VerticalAlignment="Center"/><TextBox x:Name="DetectionRateInput" Text="{Binding BootstrapRate,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" Width="80" Margin="6,0,0,0" MinHeight="32" Padding="7,5"/>
    </WrapPanel>
   </DockPanel>
   <Grid Margin="0,10,0,0" Visibility="{Binding HasOperationFeedback,Converter={StaticResource VisibleWhen}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding OperationElapsedText}" Foreground="{StaticResource MutedBrush}" FontSize="12"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding OperationHeadline}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,14,0"/><TextBlock Text="{Binding OperationDetail}" FontSize="12" Foreground="{StaticResource MutedBrush}" MaxWidth="650" TextTrimming="CharacterEllipsis" ToolTip="{Binding OperationDetail}" VerticalAlignment="Center"/></StackPanel></DockPanel>
    <ProgressBar Grid.Row="1" Value="{Binding OperationProgress,Mode=OneWay}" IsIndeterminate="{Binding OperationIndeterminate}" Height="5" Margin="0,7,0,0" Minimum="0" Maximum="100"/>
   </Grid>
   <DataGrid x:Name="ParallelTrainingJobs" ItemsSource="{Binding ParallelJobs}" Visibility="{Binding HasParallelJobs,Converter={StaticResource VisibleWhen}}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="150" Margin="0,10,0,0" RowHeight="28" HeadersVisibility="Column">
    <DataGrid.Columns><DataGridTextColumn Header="类别" Binding="{Binding ClassName,Mode=OneWay}" Width="90"/><DataGridTextColumn Header="状态" Binding="{Binding State,Mode=OneWay}" Width="90"/><DataGridTextColumn Header="Epoch" Binding="{Binding EpochText,Mode=OneWay}" Width="90"/><DataGridTextColumn Header="Loss" Binding="{Binding Loss,Mode=OneWay,StringFormat=F5}" Width="95"/><DataGridTextColumn Header="耗时" Binding="{Binding ElapsedText,Mode=OneWay}" Width="70"/><DataGridTextColumn Header="进度与结果" Binding="{Binding Detail,Mode=OneWay}" Width="*"/></DataGrid.Columns>
   </DataGrid></StackPanel>
  </Border>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid IsEnabled="{Binding IsIdle}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="类别 · 已确认 / 总数" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <ListBox x:Name="FolderClasses" Grid.Row="1" ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Caption" MaxHeight="154" BorderBrush="{StaticResource LineBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    <TextBlock Grid.Row="2" Text="选择图片，拖拽画框" FontWeight="SemiBold" Margin="0,12,0,8"/>
    <DataGrid x:Name="FolderImages" Grid.Row="3" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedRow}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="30" BorderBrush="{StaticResource LineBrush}" EnableRowVirtualization="True">
     <DataGrid.Columns><DataGridTextColumn Header="图像" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="类别" Binding="{Binding ClassName}" Width="64"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="62"/></DataGrid.Columns>
    </DataGrid>
   </Grid>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,8"><StackPanel x:Name="PredictionThresholdParameters" DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding IsIdle}"><TextBlock Text="预测阈值" VerticalAlignment="Center" Margin="12,0,6,0"/><TextBox x:Name="PredictionConfidenceInput" Margin="0" Text="{Binding PredictionConfidence,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" Width="68" Padding="7,4" MinHeight="30" ToolTip="大于0且不超过1；0.05表示5%。低阈值只用于人工预标注，修改后重新预测生效。"/></StackPanel><StackPanel DockPanel.Dock="Left" Orientation="Horizontal" IsEnabled="{Binding IsIdle}"><Button x:Name="ShowImageEditorButton" MinHeight="30" Content="大图编辑" Command="{Binding ShowImageEditorCommand}" Padding="12,5"/><Button x:Name="ShowThumbnailOverviewButton" MinHeight="30" Content="缩略图总览" Command="{Binding ShowThumbnailOverviewCommand}" Padding="12,5" Margin="6,0,12,0"/></StackPanel><TextBlock Text="{Binding ThumbnailSummary}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/></DockPanel>
     <views:DetectionImageView Grid.Row="1" x:Name="DetectionImage" ImagePath="{Binding PreviewPath}" Boxes="{Binding PreviewBoxes}" Categories="{Binding Categories}" DrawBoxCommand="{Binding DrawBoxCommand}" EditBoxCommand="{Binding EditBoxCommand}" SelectedBoxIndex="{Binding SelectedBoxIndex,Mode=TwoWay}" IsEnabled="{Binding IsIdle}" Visibility="{Binding IsImageEditor,Converter={StaticResource VisibleWhen}}"/>
     <ScrollViewer Grid.Row="1" x:Name="ThumbnailOverview" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsThumbnailOverview,Converter={StaticResource VisibleWhen}}" Background="White" IsEnabled="{Binding IsIdle}">
      <ItemsControl x:Name="ThumbnailImages" ItemsSource="{Binding Items}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
       <Button Width="146" Height="192" Margin="4" Padding="5" Command="{Binding DataContext.OpenThumbnailCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{Binding Image.ImagePath}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#18212A"><Image Stretch="Uniform"><Image.Source><MultiBinding Converter="{StaticResource Thumbnail}"><Binding/><Binding Path="DataContext.PredictionMaxBoxes" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></Image.Source></Image></Border><TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,5,0,2"/><DockPanel Grid.Row="2"><TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="11"><TextBlock.Text><MultiBinding Converter="{StaticResource Thumbnail}" ConverterParameter="count"><Binding/><Binding Path="DataContext.PredictionMaxBoxes" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></TextBlock.Text></TextBlock><TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="11"/></DockPanel></Grid>
       </Button>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </ScrollViewer>
    </Grid>
    <DockPanel Grid.Row="1" Margin="0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding PredictionPolicy}" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding SelectedDetails}" Foreground="{StaticResource MutedBrush}" Visibility="{Binding IsImageEditor,Converter={StaticResource VisibleWhen}}"/></DockPanel>
    <DockPanel Grid.Row="2" Margin="0,0,0,6">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="保存草稿" Command="{Binding SaveDraftCommand}" IsEnabled="{Binding CanReview}" Margin="0,0,8,0" Visibility="{Binding IsImageEditor,Converter={StaticResource VisibleWhen}}"/><Button x:Name="ApproveAllImagesButton" Content="{Binding ApproveAllLabel}" Command="{Binding ApproveAllCommand}" IsEnabled="{Binding CanApproveAll}" Margin="0,0,8,0" ToolTip="仅确认当前类别有有效检测框的待审核图片；无框、需重标和其他类别保持不变"/><Button x:Name="ApproveImageButton" Content="确认并下一张" Command="{Binding ApproveCommand}" IsEnabled="{Binding CanReview}" Style="{StaticResource PrimaryButton}" Visibility="{Binding IsImageEditor,Converter={StaticResource VisibleWhen}}"/></StackPanel>
     <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanReview}" Visibility="{Binding IsImageEditor,Converter={StaticResource VisibleWhen}}"><TextBlock Text="画框类别" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="DrawClassSelector" ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding DrawClassId,Mode=TwoWay}" Width="120" VerticalAlignment="Center"/><Button Content="下一张" Command="{Binding NextCommand}" Margin="8,0,12,0"/></StackPanel>
    </DockPanel>
    <Expander Grid.Row="3" Header="检测框坐标与类别" IsExpanded="False" Padding="0" IsEnabled="{Binding CanReview}" Visibility="{Binding IsImageEditor,Converter={StaticResource VisibleWhen}}">
     <DockPanel Margin="0,8,0,0"><StackPanel DockPanel.Dock="Right" Margin="8,0,0,0"><Button Content="添加框" Command="{Binding AddBoxCommand}"/><Button Content="删除所选框" Command="{Binding RemoveBoxCommand}" IsEnabled="{Binding CanRemoveBox}" Margin="0,8,0,0"/><Button Content="需重标" Command="{Binding ReworkCommand}" Margin="0,8,0,0"/></StackPanel>
      <DataGrid ItemsSource="{Binding Boxes}" SelectedItem="{Binding SelectedBox}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="30" Height="130">
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="类别" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.Categories,RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ClassId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="得分" Binding="{Binding Confidence,StringFormat=P0}" Width="55" IsReadOnly="True"/>
        <DataGridTextColumn Header="X1" Binding="{Binding Col1,Mode=TwoWay,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True,StringFormat=F1}" Width="*"/>
        <DataGridTextColumn Header="Y1" Binding="{Binding Row1,Mode=TwoWay,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True,StringFormat=F1}" Width="*"/>
        <DataGridTextColumn Header="X2" Binding="{Binding Col2,Mode=TwoWay,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True,StringFormat=F1}" Width="*"/>
        <DataGridTextColumn Header="Y2" Binding="{Binding Row2,Mode=TwoWay,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True,StringFormat=F1}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
    </Expander>
   </Grid>
  </Grid>
  <StackPanel Grid.Row="4" Margin="0,6,0,0">
   <Expander Header="更多操作 · 单图选择、导出与读取提示" IsExpanded="False" Padding="0" Margin="0"><ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"><StackPanel>
    <WrapPanel Margin="0,8,0,0"><Button Content="单独选择图片建类别" Command="{Binding SeedCommand}" IsEnabled="{Binding IsIdle}" Margin="0,0,8,8"/><Button Content="继续添加图片" Command="{Binding AddImagesCommand}" IsEnabled="{Binding CanAddImages}" Margin="0,0,8,8"/><Button Content="已有模型预测" Command="{Binding PredictExistingCommand}" IsEnabled="{Binding IsIdle}" Margin="0,0,8,8"/><Button Content="选择图片预测" Command="{Binding PredictTrainedCommand}" IsEnabled="{Binding CanPredictTrained}" Margin="0,0,8,8"/><Button Content="导入预测 JSON" Command="{Binding ImportCommand}" IsEnabled="{Binding IsIdle}" Margin="0,0,8,8"/><Button Content="合并导出 .hdict" Command="{Binding ExportAllHalconCommand}" IsEnabled="{Binding CanExportAllHalcon}" Margin="0,0,8,8"/><Button Content="本类导出 .hdict" Command="{Binding ExportHalconCommand}" IsEnabled="{Binding CanExport}" Margin="0,0,8,8"/><Button x:Name="ParallelTrainingButton" Content="分类别并行训练…" Command="{Binding ParallelTrainCommand}" IsEnabled="{Binding CanParallelTrain}" Margin="0,0,8,8"/><Button Content="导出已确认 COCO" Command="{Binding ExportCommand}" IsEnabled="{Binding CanExport}" Margin="0,0,8,8"/><Button Content="打开导出目录" Command="{Binding OpenExportCommand}" IsEnabled="{Binding CanOpenExport}" Margin="0,0,0,8"/></WrapPanel>
    <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsIdle}" Margin="0,0,0,8"><TextBlock Text="训练引擎" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox SelectedValuePath="Content" SelectedValue="{Binding TrainingEngine,Mode=TwoWay}" Width="137"><ComboBoxItem Content="YOLO · 预训练"/><ComboBoxItem Content="HALCON · 检测"/></ComboBox></StackPanel>
    <StackPanel x:Name="PredictionOptions" Orientation="Horizontal" IsEnabled="{Binding IsIdle}" Margin="0,0,0,8"><TextBlock Text="每图最多预测框" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="PredictionMaxBoxesInput" Text="{Binding PredictionMaxBoxes,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" Width="65" MinHeight="30" Padding="7,5"/><TextBlock Text="1～300；默认单目标，仅限制模型候选。修改后重新选择图片或预测生效。" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" FontSize="12"/></StackPanel>
    <Expander Header="运行日志" IsExpanded="False"><TextBox Text="{Binding OperationLog,Mode=OneWay}" IsReadOnly="True" Height="100" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontSize="12"/></Expander>
    <TextBlock Text="{Binding TrainedModel}" Foreground="{StaticResource MutedBrush}"/><ItemsControl ItemsSource="{Binding ImportIssues}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></ScrollViewer></Expander>
  </StackPanel>
 </Grid>
</UserControl>
