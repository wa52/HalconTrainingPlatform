<UserControl x:Class="HalconTraining.App.Views.ProjectOverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="28">
        <TextBlock Text="项目总览" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="独立训练工作台 · 项目 / 任务 / 运行环境" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,22" />
        <Border Background="#FFFFF2DC" BorderBrush="#FFE6D3AB" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="设备兼容性待训练验证" FontWeight="SemiBold" Foreground="#FF79590C" />
                <TextBlock Text="RTX 5060 的计算能力超出 HALCON 24.11 公布的 GPU 支持范围。环境检查只采集本机信息；任务训练和推理能力仍需实际验证。" TextWrapping="Wrap" Foreground="#FF79590C" Margin="0,6,0,0" /></StackPanel>
        </Border>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="本机训练环境" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DataContext.EnvironmentSummary, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,10,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DataContext.LastError, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#FFBA3B47" Margin="0,6,0,0" TextWrapping="Wrap" />
                <DataGrid ItemsSource="{Binding DataContext.LastReport.Checks, RelativeSource={RelativeSource AncestorType=Window}}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Margin="0,16,0,0" MinHeight="220" Background="White" BorderThickness="0">
                    <DataGrid.Columns><DataGridTextColumn Header="检查项" Binding="{Binding Name}" Width="180" /><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="110" /><DataGridTextColumn Header="说明" Binding="{Binding Summary}" Width="*" /></DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding Actions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate>
            <DataTemplate><Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,12,12"><StackPanel><DockPanel><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}"/></DockPanel><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/></StackPanel></Border></DataTemplate>
        </ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
</UserControl>
