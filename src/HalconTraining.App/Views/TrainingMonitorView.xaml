<UserControl x:Class="HalconTraining.App.Views.TrainingMonitorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:HalconTraining.App.Views">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <Border Style="{StaticResource Card}"><StackPanel>
   <TextBlock Text="训练监控" Style="{StaticResource CardTitle}"/>
   <UniformGrid Columns="3" Margin="0,16,0,10">
    <StackPanel Margin="0,0,0,14"><TextBlock Text="当前轮次" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding Epoch}" Style="{StaticResource StatValue}"/></StackPanel>
    <StackPanel><TextBlock Text="已用时间" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding ElapsedText}" Style="{StaticResource StatValue}"/></StackPanel>
    <StackPanel><TextBlock Text="预计训练剩余" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding RemainingText}" Style="{StaticResource StatValue}"/></StackPanel>
    <StackPanel><TextBlock Text="平滑训练 Loss" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding Loss}" Style="{StaticResource StatValue}"/></StackPanel>
    <StackPanel><TextBlock Text="{Binding ValidationMetricLabel}" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding ValidationIoU}" Style="{StaticResource StatValue}"/></StackPanel>
    <StackPanel><TextBlock Text="{Binding BestMetricLabel}" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding BestValidationIoU}" Style="{StaticResource StatValue}"/></StackPanel>
   </UniformGrid>
   <ProgressBar Value="{Binding Progress,Mode=OneWay}" IsIndeterminate="{Binding IsWaiting,Mode=OneWay}" Maximum="100" Height="6"/>
   <DockPanel Margin="0,12,0,4"><TextBlock Text="迭代  "/><TextBlock Text="{Binding IterationText}" FontFamily="Consolas"/><TextBlock Text="{Binding LearningRateText,StringFormat=学习率 {0}}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/></DockPanel>
   <TextBlock Text="{Binding StageHint}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,14,0"><TextBlock Text="训练 Loss" Style="{StaticResource CardTitle}"/><TextBlock Text="最近1000样本平滑 · 训练批次实时更新" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,8"/><views:TrainingPlot Points="{Binding TrainingCurve}" Height="205"/></StackPanel>
   <StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="{Binding ValidationMetricLabel}" Style="{StaticResource CardTitle}"/><TextBlock Text="完整验证集 · 验证轮次更新" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,8"/><views:TrainingPlot Points="{Binding ValidationCurve}" IsPercentage="True" Height="205"/></StackPanel>
  </Grid></Border>
  <Border Style="{StaticResource Card}"><Expander Header="验证样本 · 原图 / 人工真值 / 本轮预测"><StackPanel Margin="0,14,0,0"><TextBlock Text="固定验证样本，验证完成后更新；不使用测试集。" Style="{StaticResource Subtitle}"/><TextBlock Text="{Binding ClassificationPreview}" FontWeight="SemiBold"  Margin="0,5,0,12"/><views:HalconImageView ImagePath="{Binding TrainingPreviewPath}" Caption="{Binding ClassificationPreview}" Height="250"><views:HalconImageView.Style><Style TargetType="views:HalconImageView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsClassification}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:HalconImageView.Style></views:HalconImageView><UniformGrid Columns="3"><UniformGrid.Style><Style TargetType="UniformGrid"><Style.Triggers><DataTrigger Binding="{Binding IsClassification}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></UniformGrid.Style><Grid Margin="0,0,8,0"><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="200"/></Grid.RowDefinitions><TextBlock Text="原图"/><views:HalconImageView Grid.Row="1" ImagePath="{Binding TrainingPreviewPath}"/></Grid><Grid Margin="0,0,8,0"><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="200"/></Grid.RowDefinitions><TextBlock Text="人工真值"/><views:HalconImageView Grid.Row="1" ImagePath="{Binding TrainingPreviewPath}" MaskPath="{Binding TrainingTruthMask}"/></Grid><Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="200"/></Grid.RowDefinitions><TextBlock Text="本轮预测"/><views:HalconImageView Grid.Row="1" ImagePath="{Binding TrainingPreviewPath}" MaskPath="{Binding TrainingPreviewMask}"/></Grid></UniformGrid></StackPanel></Expander></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="每轮记录" Style="{StaticResource CardTitle}"/><DataGrid ItemsSource="{Binding EpochMetrics}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="140" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Epoch" Binding="{Binding Epoch}" Width="60"/><DataGridTextColumn Header="训练 Loss" Binding="{Binding TrainingLoss,StringFormat=F5}" Width="*"/><DataGridTextColumn Header="验证指标" Binding="{Binding ValidationIoU,StringFormat=P2,TargetNullValue=—}" Width="*"/><DataGridTextColumn Header="本轮秒数" Binding="{Binding Seconds,StringFormat=F1}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Border>
  <Border Style="{StaticResource Card}"><Expander Header="运行日志"><TextBox Text="{Binding LogText,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Height="180" Margin="0,12,0,0"/></Expander></Border>
 </StackPanel></ScrollViewer>
</UserControl>
