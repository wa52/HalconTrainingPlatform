<UserControl x:Class="HalconTraining.App.Views.TrainingMonitorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:HalconTraining.App.Views" xmlns:views="clr-namespace:HalconTraining.App.Views">
 <Border Background="White" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16"><TextBlock Text="{Binding TrainingStateText}" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="训练监控" FontSize="16" FontWeight="SemiBold"/></DockPanel>
  <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding ShowTrainingMonitor}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="开始训练后显示实时曲线" FontSize="18" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="选择数据集并确认左侧参数，然后点击“开始训练”。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowTrainingMonitor}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><StackPanel>
   <UniformGrid Columns="4" Margin="0,0,0,16"><StackPanel><TextBlock Text="轮次" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding Epoch}" Style="{StaticResource StatValue}"/></StackPanel><StackPanel><TextBlock Text="训练 Loss" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding Loss}" Style="{StaticResource StatValue}"/></StackPanel><StackPanel><TextBlock Text="{Binding ValidationMetricLabel}" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding ValidationIoU}" Style="{StaticResource StatValue}"/></StackPanel><StackPanel><TextBlock Text="已用时间" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding ElapsedText}" Style="{StaticResource StatValue}"/></StackPanel></UniformGrid>
   <ProgressBar Value="{Binding Progress,Mode=OneWay}" IsIndeterminate="{Binding IsWaiting,Mode=OneWay}" Maximum="100" Height="6"/>
   <DockPanel Margin="0,12,0,8"><TextBlock Text="{Binding RemainingText,StringFormat=预计剩余 {0}}" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding IterationText,StringFormat=迭代 {0}}" Foreground="{StaticResource MutedBrush}"/></DockPanel>
   <TextBlock Text="{Binding StageHint}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="训练 Loss" FontWeight="SemiBold"/><views:TrainingPlot Points="{Binding TrainingCurve}" Height="240"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="{Binding ValidationMetricLabel}" FontWeight="SemiBold"/><views:TrainingPlot Points="{Binding ValidationCurve}" IsPercentage="True" Height="240"/></StackPanel>
   </Grid>
   <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0"><Expander ui:ActionVisual.Kind="Metrics" Header="详细训练指标"><StackPanel Margin="0,12,0,0"><TextBlock Text="{Binding BestValidationIoU,StringFormat=最佳验证指标  {0}}"/><TextBlock Text="{Binding LearningRateText,StringFormat=当前学习率  {0}}" Margin="0,8"/><DataGrid ItemsSource="{Binding EpochMetrics}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="160"><DataGrid.Columns><DataGridTextColumn Header="Epoch" Binding="{Binding Epoch}" Width="60"/><DataGridTextColumn Header="训练 Loss" Binding="{Binding TrainingLoss,StringFormat=F5}" Width="*"/><DataGridTextColumn Header="验证指标" Binding="{Binding ValidationIoU,StringFormat=P2,TargetNullValue=—}" Width="*"/><DataGridTextColumn Header="秒数" Binding="{Binding Seconds,StringFormat=F1}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Expander></Border>
   <Expander ui:ActionVisual.Kind="Eye" Header="验证样本"><StackPanel Margin="0,12,0,0"><TextBlock Text="固定验证样本，每次验证完成后更新。" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
    <TextBlock Text="{Binding ClassificationPreview}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <views:HalconImageView ImagePath="{Binding TrainingPreviewPath}" Height="280"><views:HalconImageView.Style><Style TargetType="views:HalconImageView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsClassification}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:HalconImageView.Style></views:HalconImageView>
    <UniformGrid Columns="3"><UniformGrid.Style><Style TargetType="UniformGrid"><Style.Triggers><DataTrigger Binding="{Binding IsClassification}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></UniformGrid.Style>
     <Grid Margin="0,0,8,0"><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="240"/></Grid.RowDefinitions><TextBlock Text="原图"/><views:HalconImageView Grid.Row="1" ImagePath="{Binding TrainingPreviewPath}"/></Grid>
     <Grid Margin="0,0,8,0"><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="240"/></Grid.RowDefinitions><TextBlock Text="人工标注"/><views:HalconImageView Grid.Row="1" ImagePath="{Binding TrainingPreviewPath}" MaskPath="{Binding TrainingTruthMask}"/></Grid>
     <Grid><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="240"/></Grid.RowDefinitions><TextBlock Text="本轮预测"/><views:HalconImageView Grid.Row="1" ImagePath="{Binding TrainingPreviewPath}" MaskPath="{Binding TrainingPreviewMask}"/></Grid>
    </UniformGrid>
   </StackPanel></Expander>
   <Expander ui:ActionVisual.Kind="Log" Header="运行日志"><TextBox Text="{Binding LogText,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Height="180" Margin="0,12,0,0"/></Expander>
  </StackPanel></ScrollViewer>
 </Grid></Border>
</UserControl>
